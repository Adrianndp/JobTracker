{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/check.sh:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev)",
      "Bash(.venv/bin/python manage.py test:*)",
      "Bash(.venv/bin/python manage.py makemigrations --check:*)",
      "Bash(.venv/bin/python manage.py showmigrations:*)",
      "Bash(.venv/bin/python manage.py sqlmigrate:*)",
      "Bash(.venv/bin/python manage.py runserver:*)",
      "Bash(curl -s localhost:5001/api/health)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./ext-key.pem)",
      "Read(./backend/instance/**)",
      "Read(./backups/**)"
    ]
  }
}
