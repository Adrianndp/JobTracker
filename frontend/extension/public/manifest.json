{
  "manifest_version": 3,
  "name": "Job Tracker",
  "description": "Save a job posting to your tracker in one click, and see your board.",
  "version": "0.4.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "sidePanel"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5001/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.xing.com/*"
      ],
      "js": [
        "xing.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.stepstone.de/*"
      ],
      "js": [
        "stepstone.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Job Tracker"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
